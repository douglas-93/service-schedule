# Modo de execução: "once" (para, aguarda DELAY, inicia e sai) ou "daemon" (roda em loop)
MODE=daemon

# Lista de nomes EXATOS dos serviços do Windows (separados por vírgula)
SERVICES=Spooler,W3SVC,MSSQLSERVER

# Modo ONCE: Tempo de espera entre a parada e a reinicialização dos serviços
DELAY=5m

# Modo DAEMON: Horários (formato HH:MM 24h) para executar as ações
STOP_AT=22:00
START_AT=06:00

# Timeout máximo de espera para cada comando de Stop/Start confirmar a alteração
CTL_TIMEOUT=30s

# Quantidade de novas tentativas de inicialização após a tentativa inicial
START_RETRIES=3

# Intervalo de espera entre as tentativas de inicialização
START_RETRY_INTERVAL=5s

# IP ou hostname do servidor remoto (deixe em branco ou remova para execução local)
REMOTE_HOST=192.168.1.100